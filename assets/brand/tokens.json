{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "brand": "Smoooth",
  "version": "1.0.0",
  "description": "Design tokens, color values, typography rules, and spatial scales for the Smoooth brand identity and runtime.",
  "tokens": {
    "color": {
      "accent": {
        "spark": {
          "hex": "#c9f27a",
          "rgb": "rgb(201, 242, 122)",
          "hsl": "hsl(79, 83%, 71%)",
          "variable": "--spark",
          "usage": "Primary interactive highlight, terminal prompt markers, high-contrast accents"
        },
        "fern-600": {
          "hex": "#00f076",
          "rgb": "rgb(0, 240, 118)",
          "hsl": "hsl(150, 100%, 47%)",
          "variable": "--fern-600",
          "usage": "Live status indicator, healthy daemon heartbeat, successful deploy states"
        },
        "spark-ink": {
          "hex": "#4e7a14",
          "rgb": "rgb(78, 122, 20)",
          "hsl": "hsl(86, 72%, 28%)",
          "variable": "--spark-ink",
          "usage": "Text color rendered on spark yellow-green backgrounds"
        }
      },
      "canvas": {
        "ink-950": {
          "hex": "#0a0b0d",
          "rgb": "rgb(10, 11, 13)",
          "hsl": "hsl(220, 13%, 5%)",
          "variable": "--ink-950",
          "usage": "Base root background, deep dark canvas"
        },
        "ink-900": {
          "hex": "#121417",
          "rgb": "rgb(18, 20, 23)",
          "hsl": "hsl(216, 12%, 8%)",
          "variable": "--ink-900",
          "usage": "Surface level 1: terminal cards, bento containers, elevated cards"
        },
        "ink-800": {
          "hex": "#1a1e24",
          "rgb": "rgb(26, 30, 36)",
          "hsl": "hsl(216, 16%, 12%)",
          "variable": "--ink-800",
          "usage": "Surface level 2: popovers, floating menus, hover states"
        }
      },
      "border": {
        "soft": {
          "hex": "#262b33",
          "rgba": "rgba(255, 255, 255, 0.08)",
          "variable": "--border-soft",
          "usage": "Subtle hairline card outlines, table dividers, panel borders"
        },
        "strong": {
          "hex": "#383f4a",
          "rgba": "rgba(255, 255, 255, 0.16)",
          "variable": "--border-strong",
          "usage": "Active focus rings, hovered container edges, active tab borders"
        }
      },
      "neutral": {
        "bone": {
          "hex": "#f3f4f6",
          "rgb": "rgb(243, 244, 246)",
          "hsl": "hsl(210, 14%, 96%)",
          "variable": "--bone",
          "usage": "Primary headings, high-contrast titles, active navigation items"
        },
        "stone-300": {
          "hex": "#d1d5db",
          "rgb": "rgb(209, 213, 219)",
          "hsl": "hsl(214, 13%, 84%)",
          "variable": "--fg",
          "usage": "Primary body copy, documentation prose"
        },
        "stone-400": {
          "hex": "#9ca3af",
          "rgb": "rgb(156, 163, 175)",
          "hsl": "hsl(218, 11%, 65%)",
          "variable": "--on-ink-muted",
          "usage": "Secondary descriptions, meta labels, timestamps, inactive tabs"
        },
        "stone-600": {
          "hex": "#4b5563",
          "rgb": "rgb(75, 85, 99)",
          "hsl": "hsl(215, 14%, 34%)",
          "variable": "--on-ink-faint",
          "usage": "Disabled text, subtle glyph markers, border hints"
        }
      },
      "feedback": {
        "amber": {
          "hex": "#f59e0b",
          "rgb": "rgb(245, 158, 11)",
          "variable": "--ember",
          "usage": "Warnings, migration notices, DAG validation pending"
        },
        "red": {
          "hex": "#ef4444",
          "rgb": "rgb(239, 68, 68)",
          "variable": "--state-danger",
          "usage": "Execution failure, fencing block, rollback triggers"
        },
        "cyan": {
          "hex": "#06b6d4",
          "rgb": "rgb(6, 182, 212)",
          "variable": "--glacier",
          "usage": "MCP protocol packets, ingress routing, SSL certificate generation"
        }
      }
    },
    "typography": {
      "display": {
        "family": "Lexend, ui-sans-serif, system-ui, sans-serif",
        "weights": [400, 500, 600, 700],
        "defaultWeight": 600,
        "letterSpacing": "-0.025em"
      },
      "body": {
        "family": "Lexend, system-ui, sans-serif",
        "weights": [300, 400, 500],
        "defaultWeight": 400,
        "lineHeight": 1.5
      },
      "mono": {
        "family": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
        "weights": [400, 500],
        "lineHeight": 1.45,
        "usage": "CLI logs, MCP JSON schema, bash one-liners, system telemetry"
      },
      "scale": {
        "display-2xl": { "size": "80px", "lineHeight": "1.0", "tracking": "-0.035em", "weight": 600 },
        "display-xl": { "size": "64px", "lineHeight": "1.0", "tracking": "-0.035em", "weight": 600 },
        "display-lg": { "size": "48px", "lineHeight": "1.08", "tracking": "-0.03em", "weight": 600 },
        "display-md": { "size": "36px", "lineHeight": "1.15", "tracking": "-0.025em", "weight": 600 },
        "title-lg": { "size": "24px", "lineHeight": "1.2", "tracking": "-0.02em", "weight": 600 },
        "title-md": { "size": "20px", "lineHeight": "1.25", "tracking": "-0.02em", "weight": 600 },
        "body-lg": { "size": "18px", "lineHeight": "1.45", "tracking": "0", "weight": 400 },
        "body-base": { "size": "15px", "lineHeight": "1.5", "tracking": "0", "weight": 400 },
        "caption": { "size": "13px", "lineHeight": "1.4", "tracking": "0.01em", "weight": 400 },
        "code-sm": { "size": "13px", "lineHeight": "1.45", "tracking": "0", "weight": 400 }
      }
    },
    "grid": {
      "baseUnit": "4px",
      "scale": [4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80, 96, 128],
      "container": {
        "max": "1280px",
        "gutter": "32px",
        "gutterMobile": "20px"
      }
    },
    "radii": {
      "xs": "4px",
      "sm": "6px",
      "md": "8px",
      "lg": "12px",
      "xl": "16px",
      "pill": "9999px (prohibited for eyebrow badges per Anti-Slop Rule)"
    }
  }
}
